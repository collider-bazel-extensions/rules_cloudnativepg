#!/usr/bin/env bash
# Generated per-version. The bin name is baked at genrule time so the
# wrapper can be exec'd directly by itest_service (which doesn't pass
# `args` from sh_binary's attr — that only fires under `bazel run`).
set -euo pipefail

INSTALL_BIN_NAME="__BIN_NAME__"
CLUSTER_NAME="cluster"

if [[ -z "${RUNFILES_DIR:-}" ]]; then
  if [[ -d "${0}.runfiles" ]]; then RUNFILES_DIR="${0}.runfiles"
  elif [[ -d "$(dirname "$0").runfiles" ]]; then RUNFILES_DIR="$(dirname "$0").runfiles"
  fi
  export RUNFILES_DIR
fi
INSTALL_BIN="${RUNFILES_DIR}/_main/tests/${INSTALL_BIN_NAME}.sh"
[[ -x "$INSTALL_BIN" ]] || { echo "wrapper: $INSTALL_BIN_NAME not at $INSTALL_BIN" >&2; exit 1; }

env_file="$TEST_TMPDIR/${CLUSTER_NAME}.env"
deadline=$(( $(date +%s) + 60 ))
while [[ ! -f "$env_file" ]]; do
  if (( $(date +%s) >= deadline )); then
    echo "install_wrapper: kind env file never appeared at $env_file" >&2
    exit 1
  fi
  sleep 1
done

set -a
# shellcheck disable=SC1090
source "$env_file"
set +a

exec "$INSTALL_BIN"
